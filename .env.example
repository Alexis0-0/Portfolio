# Contact form service configuration
# Use ONE of the two options below. If neither is set, the contact form
# falls back to opening the visitor's email client (mailto:) automatically.

# Option 1: Formspree (https://formspree.io)
# Create a form at Formspree and paste its endpoint URL here.
VITE_FORMSPREE_ENDPOINT=

# Option 2: Web3Forms (https://web3forms.com)
# Free access key, no account required for basic use.
VITE_WEB3FORMS_ACCESS_KEY=
